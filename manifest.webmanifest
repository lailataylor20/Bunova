{
  "id": "/",
  "name": "Bunova",
  "short_name": "Bunova",
  "description": "Learn Russian with Buni the bunny: lessons, listening, speaking and spaced review.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f7f9fb",
  "theme_color": "#4cb000",
  "categories": ["education"],
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon-180.png", "sizes": "180x180", "type": "image/png", "purpose": "any" }
  ],
  "screenshots": [
    { "src": "/screenshot-narrow.png", "sizes": "540x1170", "type": "image/png", "form_factor": "narrow", "label": "Your coach suggests what to do next" },
    { "src": "/screenshot-wide.png", "sizes": "1280x720", "type": "image/png", "form_factor": "wide", "label": "Bunova on a computer" }
  ],
  "shortcuts": [
    { "name": "Today's session", "short_name": "Today", "url": "/#today", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Speak", "short_name": "Speak", "url": "/#talk", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Listen", "short_name": "Listen", "url": "/#read", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
